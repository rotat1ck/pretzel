<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Pretzel.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:exploreComps="clr-namespace:Pretzel.App.Components.Explore"
             xmlns:buttons="clr-namespace:Pretzel.App.Components.Buttons"
             x:Class="Pretzel.App.Views.ExplorePage"
             x:DataType="viewModels:ExploreViewModel"
             Background="{StaticResource Primary}">

    <Border Stroke="{StaticResource PrimaryStroke}" 
            StrokeThickness="1" 
            Margin="-2,0,-2,0"> <!-- trick for making stroke on top and bottom -->

        <Grid RowDefinitions="Auto,*" 
              Padding="24,32,24,0"
              RowSpacing="16">
            <exploreComps:SearchOptionsView />
            <exploreComps:SearchResultsView Grid.Row="1"/>
        </Grid>
    </Border>
</ContentPage>