<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Pretzel.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:comps="clr-namespace:Pretzel.App.Components"
             xmlns:buttons="clr-namespace:Pretzel.App.Components.Buttons"
             x:Class="Pretzel.App.Views.ExplorePage"
             x:DataType="viewModels:ExploreViewModel"
             Background="{StaticResource Primary}">

    <Border Stroke="{StaticResource PrimaryStroke}" 
            StrokeThickness="1" 
            Margin="-2,0,-2,0"> <!-- trick for making stroke on top and bottom -->

        <Grid RowDefinitions="Auto,*" 
              Padding="24,32,24,0">
            <StackLayout >
                <HorizontalStackLayout>
                    <SearchBar x:Name="MySearchBar" Placeholder="Search..."/>
                    <Button Text="something"/>
                    <Button Text="Open" Command="{Binding ToggleAdvancedCommand}"/>
                </HorizontalStackLayout>

                <toolkit:Expander IsExpanded="{Binding IsAdvancedSearch}">
                    <toolkit:Expander.Behaviors>
                        <comps:ExpanderAnimationBehavior Duration="200"/>
                    </toolkit:Expander.Behaviors>
                    <Border>
                        <RoundRectangle BackgroundColor="Red" HeightRequest="500" />
                    </Border>
                </toolkit:Expander>

                <Label FontSize="30" Text="this should move" />
                <buttons:PrimaryButtonView ButtonCommand="{Binding SearchCommand}" ButtonText="EXECUTE SEARCH" ButtonImage="settings_icon.png" HeightRequest="50" />
            </StackLayout>
        </Grid>
    </Border>
</ContentPage>