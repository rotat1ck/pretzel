<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Pretzel.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Pretzel.App.Views.ExplorePage"
             x:DataType="viewModels:ExploreViewModel">
    <Grid RowDefinitions="Auto,*" Padding="24,32,24,0">
        <StackLayout>
            <!-- above -->
            <HorizontalStackLayout>
                <SearchBar x:Name="MySearchBar" Placeholder="Search..."/>
                <Button Text="something"/>
                <Button Text="Open" Command="{Binding ToggleAdvancedCommand}"/>
            </HorizontalStackLayout>

            <!-- dropdown -->
            <toolkit:Expander IsExpanded="{Binding IsAdvancedSearch}">
                <Border>
                    <RoundRectangle BackgroundColor="Red" HeightRequest="500" />
                    <Border.Behaviors>
                        <toolkit:AnimationBehavior EventName="SizeChanged" AnimationType="{x:Static Easing.SpringOut}">
                            
                        </toolkit:AnimationBehavior>
                    </Border.Behaviors>
                </Border>
            </toolkit:Expander>
        </StackLayout>
    </Grid>
</ContentPage>