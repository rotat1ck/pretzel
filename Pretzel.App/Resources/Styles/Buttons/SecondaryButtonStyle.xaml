<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Buttons/BaseButtonStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="buttonBorderStyle" TargetType="Border" BasedOn="{StaticResource buttonBorderStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryDarkButton}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
    </Style>

    <Style x:Key="buttonBorderHoveredStyle" TargetType="Border" BasedOn="{StaticResource buttonBorderStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryDarkButton}" />
    </Style>

    <Style x:Key="buttonGridStyle" TargetType="Grid" BasedOn="{StaticResource buttonGridStyle}">
        <Setter Property="ColumnDefinitions" Value="Auto,Auto" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="ColumnSpacing" Value="4" />
        <Setter Property="Padding" Value="12,0,12,0" />
    </Style>

    <Style x:Key="buttonImageStyle" TargetType="Image" BasedOn="{StaticResource buttonImageStyle}">
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="WidthRequest" Value="16" />
    </Style>

    <Style x:Key="buttonLabelStyle" TargetType="Label" BasedOn="{StaticResource buttonLabelStyle}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Lexend" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryLightText}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
</ResourceDictionary>