<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:comps="clr-namespace:Pretzel.App.Components"
             xmlns:buttons="clr-namespace:Pretzel.App.Components.Buttons"
             xmlns:viewModels="clr-namespace:Pretzel.App.ViewModels"
             x:Class="Pretzel.App.Components.Explore.SearchOptionsView"
             x:DataType="viewModels:ExploreViewModel">
    <StackLayout>
        <Grid ColumnDefinitions="*,2*">
            
            <Border Stroke="{StaticResource PrimaryStroke}"
                    StrokeShape="RoundRectangle 4"
                    StrokeThickness="1">
                
                <SearchBar Text="{Binding BasicSearchOptions.Search}"
                           FontFamily="Lexend"
                           TextColor="{StaticResource PrimaryLightText}"
                           BackgroundColor="{StaticResource PrimaryDark}"
                           SearchIconColor="{StaticResource PrimaryLightText}"/>
            </Border>
            
            <Grid Grid.Column="1"
                  ColumnDefinitions="Auto,Auto,*">
                
                <buttons:SecondaryButtonView ButtonText="ANY INSTRUMENT" 
                                             IsEnabled="False"/>
                <buttons:SecondaryButtonView Grid.Column="1"
                                             ButtonText="ANY DIFFICULTY" 
                                             IsEnabled="False"/>
                <buttons:TransparentButtonView Grid.Column="2"
                                               ButtonText="ADVANCED SEARCH" 
                                               HorizontalOptions="End"/>
            </Grid>
        </Grid>

        <toolkit:Expander IsExpanded="{Binding IsAdvancedSearch}">
            
        </toolkit:Expander>
    </StackLayout>
</ContentView>
