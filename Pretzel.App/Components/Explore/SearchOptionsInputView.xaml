<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pretzel.App.Components.Explore.SearchOptionsInputView"
             x:Name="root">

    <Border Background="{StaticResource PrimaryDark}"
            Stroke="{StaticResource PrimaryStroke}"
            StrokeShape="RoundRectangle 4"
            StrokeThickness="1">
        
        <Entry TextColor="{StaticResource SecondaryLightText}"
               Placeholder="{Binding Source={x:Reference root}, Path=PlaceholderText}" 
               Text="{Binding Source={x:Reference root}, Path=Input}" />
    </Border>
</ContentView>
