<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chartModels="clr-namespace:Pretzel.Core.Models.Chart;assembly=Pretzel.Core"
             x:Class="Pretzel.App.Components.Explore.ChartInstrumentView"
             x:DataType="chartModels:ChartInstrument">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 6"
            Padding="5,2,5,5"
            Stroke="{StaticResource PrimaryDark}"
            Background="{StaticResource SecondaryDarkButton}"
            ToolTipProperties.Text="{Binding Instrument}">

        <Grid RowDefinitions="Auto,Auto">

            <!-- available difficulties -->
            <Label x:Name="difficulties"
                   Text="Expert"
                   TextColor="{StaticResource PrimaryLightText}"
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>

            <!-- instrument image -->
            <Image x:Name="instrumentImage" 
                   Grid.Row="1"
                   VerticalOptions="Start"
                   HeightRequest="56"
                   WidthRequest="56"
                   Loaded="InstrumentImage_Loaded" />

            <!-- chorus encore style instrument rating -->
            <Border Grid.Row="1"
                    VerticalOptions="End"
                    HorizontalOptions="Start"
                    Background="#FF5964"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Padding="5,0,5,0">

                <Label Text="{Binding Rating}"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontSize="14" /> 
            </Border>
        </Grid>
    </Border>
</ContentView>
