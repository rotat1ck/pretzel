<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Pretzel.Core.Models;assembly=Pretzel.Core"
             x:Class="Pretzel.App.Components.Explore.ChartInstrumentView"
             x:DataType="models:ChartInstrument">

    <Border StrokeThickness="0"
            StrokeShape="RoundRectangle 6"
            Padding="5,2,5,5"
            Stroke="{StaticResource PrimaryDark}"
            Background="{StaticResource SecondaryDarkButton}">

        <Grid RowDefinitions="Auto,Auto">

            <Label x:Name="difficulties"
                   Text="Expert"
                   TextColor="{StaticResource PrimaryLightText}"
                   FontSize="16"
                   HorizontalTextAlignment="Center"/>

            <Image Grid.Row="1"
                   VerticalOptions="Start"
                   HeightRequest="56"
                   WidthRequest="56"
                   Source="instrument_guitar.png" />

            <Border Grid.Row="1"
                    VerticalOptions="End"
                    HorizontalOptions="Start"
                    Background="#FF5964"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    Padding="5,0,5,0">

                <Label Text="{Binding Rating}"
                       TextColor="Black"
                       FontAttributes="Bold"
                       FontSize="14" /> 
            </Border>
        </Grid>
    </Border>
</ContentView>
