<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Pretzel.App.Components.Explore"
             xmlns:chartModels="clr-namespace:Pretzel.Core.Models.Chart;assembly=Pretzel.Core"
             xmlns:viewModels="clr-namespace:Pretzel.App.ViewModels"
             xmlns:converters="clr-namespace:Pretzel.App.Converters"
             x:Class="Pretzel.App.Components.Explore.ChartView"
             x:DataType="viewModels:ChartViewModel">

    <Border Padding="16"
            Stroke="{StaticResource PrimaryStroke}"
            Background="{StaticResource PrimaryDark}"
            StrokeThickness="1">

        <Grid ColumnDefinitions="2*,*,2*,*,*"
              ColumnSpacing="5">
            
            <!-- song info -->
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">
                <!-- song image -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">

                    <Image HeightRequest="96"
                           Aspect="AspectFill">
                        <Image.Source>
                            <UriImageSource Uri="{Binding Chart.DownloadSources[0].AlbumArtUri,
                                                  FallbackValue='album_art_placeholder.png',
                                                  TargetNullValue='album_art_placeholder.png'}"
                                            CachingEnabled="True"
                                            CacheValidity="4:00:00"/>
                        </Image.Source>
                    </Image>
                </Border>

                <!-- song name, artist, album -->
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{Binding Chart.Name}"
                           TextColor="{StaticResource PrimaryLightText}"
                           LineBreakMode="WordWrap"
                           FontSize="22" 
                           FontAttributes="Bold" />
                    <Label Text="{Binding Chart.Artist}"
                           TextColor="{StaticResource PrimaryLightText}"
                           LineBreakMode="WordWrap"
                           FontSize="14" />
                    <Label Text="{Binding Chart.Album}"
                           TextColor="{StaticResource SecondaryLightText}"
                           LineBreakMode="WordWrap"
                           FontSize="14" />
                </VerticalStackLayout>
            </Grid>
            
            <!-- genre, year, charter -->
            <VerticalStackLayout Grid.Column="1"
                     HorizontalOptions="End">

                <Label HorizontalOptions="End"
                       Text="{Binding Chart.Genre}"
                       TextColor="{StaticResource SecondaryLightText}"
                       FontSize="12">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label" 
                                     Binding="{Binding Chart.Genre}"
                                     Value="{x:Null}">

                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label HorizontalOptions="End"
                       Text="{Binding Chart.Year, StringFormat='Year: {0}'}"
                       TextColor="{StaticResource SecondaryLightText}"
                       FontSize="12">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label" 
                         Binding="{Binding Chart.Year}"
                         Value="{x:Null}">

                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label HorizontalOptions="End"
                       Text="{Binding Chart.Charter, StringFormat='charted by: {0}'}"
                       TextColor="{StaticResource PrimaryLightText}"
                       FontSize="12">

                    <Label.Triggers>
                        <DataTrigger TargetType="Label" 
                                     Binding="{Binding Chart.Charter}"
                                     Value="{x:Null}">

                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </VerticalStackLayout>

            <!-- instruments info -->
            <FlexLayout Grid.Column="2" 
                        Direction="Row"
                        JustifyContent="Start"
                        Wrap="Wrap"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        BindableLayout.ItemsSource="{Binding Chart.Instruments}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="chartModels:ChartInstrument">
                        <local:ChartInstrumentView BindingContext="{Binding}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Button Grid.Column="4"
                    Text="{Binding ChartDownloadStatus}"
                    FontSize="20"
                    TextColor="{StaticResource PrimaryLightText}"
                    Command="{Binding DownloadChartCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                                 Binding="{Binding DownloadStatus}"
                                 Value="{x:Null}">
                        <Setter Property="Text" Value="Download" />
                    </DataTrigger>
                </Button.Triggers>
                
                <Button.CommandParameter>
                    <MultiBinding Converter="{converters:ChartDownloadSourceTupleValueConverter}">
                        <Binding Path="Chart" />
                        <Binding Path="Chart.DownloadSources[0]" />
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </Grid>
    </Border>
    
</ContentView>
