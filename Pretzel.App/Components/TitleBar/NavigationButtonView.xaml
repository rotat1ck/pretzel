<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pretzel.App.Components.TitleBar.NavigationButtonView"
             x:Name="root">

    <Border Stroke="Transparent" 
        StrokeShape="RoundRectangle 4" 
        BackgroundColor="#3C4A5E">

        <Grid ColumnDefinitions="Auto,Auto" 
          ColumnSpacing="4"
          Padding="12,0,12,0">
            <Image Source="{Binding Source={x:Reference root}, Path=ButtonImage}" Aspect="AspectFit" HeightRequest="16" WidthRequest="16"/>
            <Label Grid.Column="1" Text="{Binding Source={x:Reference root}, Path=ButtonText}" FontSize="14" VerticalOptions="Center"/>
        </Grid>
    </Border>

</ContentView>
