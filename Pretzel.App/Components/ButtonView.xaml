<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pretzel.App.Components.ButtonView"
             Background="Transparent"
             x:Name="root">
   
    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Command="{Binding Source={x:Reference root}, Path=ButtonCommand}" 
                              CommandParameter="{Binding Source={x:Reference root}, Path=ButtonCommandParameter}" />
    </ContentView.GestureRecognizers>

    <Border>
        <Grid>
            <Image Source="{Binding Source={x:Reference root}, Path=ButtonImage}">
                <Image.Triggers>
                    <Trigger TargetType="Image" Property="Source" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False"/>
                    </Trigger>
                </Image.Triggers>
            </Image>

            <Label Grid.Column="1" 
                   Text="{Binding Source={x:Reference root}, Path=ButtonText}"/>   
        </Grid>
    </Border>
</ContentView>
