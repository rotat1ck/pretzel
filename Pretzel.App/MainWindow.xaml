<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:local="clr-namespace:Pretzel.App"
        xmlns:titleBarComps="clr-namespace:Pretzel.App.Components.TitleBar"
        x:Class="Pretzel.App.MainWindow">
    
    <Window.TitleBar>
        <TitleBar BackgroundColor="#081425" 
                  HeightRequest="50">
            <TitleBar.LeadingContent>
                <HorizontalStackLayout Grid.Column="0" 
                                       Spacing="16" 
                                       Padding="24,5,0,5">

                    <titleBarComps:NavigationButtonView ButtonText="Library"/>

                </HorizontalStackLayout>
            </TitleBar.LeadingContent>
            
            <TitleBar.TrailingContent>
                <RoundRectangle Margin="0,10,0,10" Background="#C4C6CD" Opacity="0.5" WidthRequest="1" StrokeThickness="0"/>
            </TitleBar.TrailingContent>
        </TitleBar>
    </Window.TitleBar>

    <local:AppShell />
</Window>